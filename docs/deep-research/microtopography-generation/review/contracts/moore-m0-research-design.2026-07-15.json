  "task": {
    "id": "M0",
    "target_surface": "H at 0.0625 m",
    "observation": "O0=Q4(Q4(H)) at 1 m",
    "q4": "fixed-order exact area mean over aligned 4x4 cells",
    "candidate_output": "one absolute Hhat at 0.0625 m",
    "parent_constraint": "Q4(Q4(Hhat))=O0 after complete world-aligned fusion",
    "production_dtm_modelled": false,
    "output_components": {
      "B1": "A1-R4(A0), A1=F4(Hhat), A0=F4(A1)",
      "derived_B2_hypothesis": "Hhat-R4(F4(Hhat))"
    },
    "joint_output_required": true,
    "independent_band_stamping_forbidden": true,
    "input_channels": [
      "structural_prolongation_of_O0",
      "gradient_of_O0",
      "laplacian_of_O0",
      "0.5_m_relief",
      "1_m_relief",
      "validity"
    ]
  },

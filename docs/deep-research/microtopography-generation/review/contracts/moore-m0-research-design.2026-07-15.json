  },
  "source_b2_gate": {
    "evaluation_time": "after_materialization_before_any_model_training",
    "candidate_independent": true,
    "definition": "B2_p=H_p-R4(F4(H_p))",
    "common_support": "intersection of complete valid footprints across all four phases",
    "phase_comparison": "exact polygon-overlap integration of half-open piecewise-constant B2 cells",
    "phase_interpolation_forbidden": true,
    "per_group_quantities": {
      "E_gp": "mean_area(B2_gp^2) for phase p",
      "E_g": "(1/4)*sum_p(E_gp)",
      "D_g": "(1/6)*sum_(p<q)(mean_area((B2_gp-B2_gq)^2))",
      "R_g": "D_g/E_g; E_g=0 is an automatic failure",
      "population_energy_cv_g": "sqrt((1/4)*sum_p((E_gp-E_g)^2))/E_g"
    },
    "spectral_operator": {
      "unit": "each complete 1 m by 1 m valid core",
      "preprocess": "subtract core mean then apply separable periodic Hann window",
      "transform": "float64 2D FFT at 0.0625 m sample spacing",
      "radial_bin_assignment": "bin by Euclidean frequency magnitude in cycles/m",
      "group_aggregation": "equal-weight mean of complete cores"
    },
    "morphology_operator": {
      "connectivity": 8,
      "forms": "signed watershed basins rooted at local extrema",
      "prominence_reference": "spill saddle in the same signed watershed",
      "prominence_scale": "MAD of B2 over the plot-phase common valid support",
      "equivalent_diameter": "2*sqrt(basin_area/pi)",
      "relief_volume": "exact cell-area integral of absolute form relief above or below its spill saddle",
      "canonical_form_id": "(group_order,plot_field_order,phase_order,sign,row_major_extremum_index)",
      "candidate_family": "same plot and sign, at most one form per phase, at least three phases, and every member pair within the centroid-distance threshold",
      "global_disjoint_selection": "within each geographic group, choose the set of candidate families with no reused form that maximizes summed member relief volume over all plots",
      "global_selection_tie_break": "lexicographically lowest sorted list of canonical family-ID tuples",
      "per_group_persistence_fraction": "selected-family member relief volume divided by total relief volume of all eligible forms across all four phases in that group; zero denominator fails"
    },
    "thresholds": {
      "minimum_usable_geographic_groups": 6,
      "R_g_every_used_group_max": 0.25,
      "population_energy_cv_group_median_max": 0.15,
      "population_energy_cv_every_used_group_max": 0.25,
      "b2_rms_group_median_min_m": 0.01,
      "nyquist_edge_band_cycles_per_m": [7.0, 8.0],
      "registered_b2_band_cycles_per_m": [4.0, 8.0],
      "nyquist_edge_energy_fraction_group_median_max": 0.15,
      "nyquist_edge_energy_fraction_every_used_group_max": 0.25,
      "form_prominence_plot_phase_mad_multiplier_min": 2.0,
      "form_equivalent_diameter_m": [0.125, 0.5],
      "form_match_centroid_distance_max_m": 0.125,
      "form_required_phase_count": 3,
      "persistent_absolute_relief_volume_fraction_every_used_group_min": 0.7
    },
    "all_thresholds_conjunctive": true,
    "failure_state": "target_evidence_insufficient_for_moore_decimeter_research_preview"
  },
